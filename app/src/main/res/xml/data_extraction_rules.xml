<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- Never cloud-backup user-triggered traces or root capture consent. -->
        <exclude domain="file" path="diagnostic-capture/" />
        <exclude domain="sharedpref" path="gonesmart_diagnostics.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Restore of consent would be unsafe on a different device. -->
        <exclude domain="file" path="diagnostic-capture/" />
        <exclude domain="sharedpref" path="gonesmart_diagnostics.xml" />
    </device-transfer>
</data-extraction-rules>
